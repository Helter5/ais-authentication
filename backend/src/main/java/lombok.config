config.stopBubbling = true

# Spring's @Lazy has @Target(FIELD) among others, so Lombok's default rule (only copy a field
# annotation onto the generated constructor parameter when the annotation ISN'T legal on FIELD)
# leaves it stranded on the field - useless there, since Spring reads @Lazy off the constructor
# parameter to decide whether to inject a lazy proxy. Whitelisting it here makes
# @RequiredArgsConstructor/@AllArgsConstructor copy it onto the parameter too, which is what
# actually breaks a startup circular-bean cycle (see SubjectRoleSlashCommandListener).
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
