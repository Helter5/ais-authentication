# Env files (obsahujú heslá/secrets, nikdy necommitovať)
.env
*.env
!.env.example

# STU's own OpenVPN profile - not a secret (verified 2026-08-17 byte-identical, SHA-256, to
# STU's public download), but not ours to redistribute either. Download it yourself (see README)
# and drop it at infra/vpn/client.ovpn. VPN credentials come from infra/.env (VPN_USERNAME/
# VPN_PASSWORD), no separate auth.txt file needed.
infra/vpn/client.ovpn

# OS
.DS_Store

# Claude Code (celý priečinok - lokálne skills/settings, netreba v public repe)
.claude/
CLAUDE.md

# IDE (repo-wide, projektové .gitignore v backend/frontend riešia zvyšok)
.idea/
.vscode/
*.iml

# Frontend (kým nepribudne frontend/.gitignore)
node_modules/
dist/

# one-off migration output (contains real PII - emails, discord ids) + the script that generates it
migration.sql
migrate-export.js

