# --- Database ---
DB_NAME=ais_auth
DB_USER=ais_auth
DB_PASSWORD=ais_auth

# --- JWT (admin dashboard session tokens) ---
# vygeneruj si vlastný náhodný string, napr.: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRATION_MINUTES=1440

# --- Super admin ---
# tvoje vlastné Discord user ID (Discord -> nastavenia -> pokročilé -> vývojársky režim,
# potom pravým klikom na svoj profil -> "Kopírovať ID uživateľa"). Viac ID odděľ čiarkou.
SUPER_ADMIN_IDS=

# --- Discord OAuth2 (admin dashboard login) ---
# vytvor appku na https://discord.com/developers/applications
# redirect URI v Discord Developer Portal musí presne sedieť s DISCORD_REDIRECT_URI nižšie
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# --- Discord bot (JDA) ---
# z tej istej Discord appky, záložka "Bot" -> Reset Token
DISCORD_BOT_TOKEN=
# ak vyplnené, slash commandy sa zaregistrujú len na tento server (okamžite);
# ak prázdne, registrujú sa globálne (prejaví sa do ~1h)
DISCORD_GUILD_ID=

# --- Frontend URL (kam sa presmeruje po prihlásení) ---
FRONTEND_URL=http://localhost:5173

# --- LDAP (STU AIS) ---
# reálny server je dostupný len cez univerzitnú VPN
LDAP_URL=ldap://ldap.stuba.sk:389
LDAP_BASE=ou=People,dc=stuba,dc=sk
LDAP_USERNAME=
LDAP_PASSWORD=

# --- Mail (Mailpit v Dockeri netreba menit) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Verifikácia <noreply@stuba.sk>
