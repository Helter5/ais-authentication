# --- Database ---
DB_NAME=ais_auth
DB_USER=ais_auth
DB_PASSWORD=ais_auth

# --- JWT (admin dashboard session tokens) ---
# openssl rand -base64 48
JWT_SECRET=
# voliteľné, defaulty: 300 / 2592000
#JWT_ACCESS_TOKEN_TTL_SECONDS=300
#JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Super admin ---
# tvoje vlastné Discord user ID (Discord -> nastavenia -> pokročilé -> vývojársky režim,
# potom pravým klikom na svoj profil -> "Kopírovať ID uživateľa"). Viac ID odděľ čiarkou.
SUPER_ADMIN_IDS=

# --- Discord OAuth2 (admin dashboard login) ---
# vytvor appku na https://discord.com/developers/applications
# redirect URI v Discord Developer Portal musí presne sedieť s DISCORD_REDIRECT_URI nižšie
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# --- Discord bot (JDA) ---
# z tej istej Discord appky, záložka "Bot" -> Reset Token
DISCORD_BOT_TOKEN=
# ak vyplnené, slash commandy sa zaregistrujú len na tento server (okamžite);
# ak prázdne, registrujú sa globálne (prejaví sa do ~1h)
DISCORD_GUILD_ID=

# --- Frontend URL (kam sa presmeruje po prihlásení) ---
FRONTEND_URL=http://localhost:5173

# --- LDAP (STU AIS) ---
# LDAP_URL platí len pre bare `./mvnw spring-boot:run` (docker compose ide cez vpn kontajner)
LDAP_URL=ldap://ldap.stuba.sk:389
LDAP_BASE=ou=People,dc=stuba,dc=sk
LDAP_USERNAME=
LDAP_PASSWORD=

# --- Mail ---
# Predvolene ide mail cez Mailpit (dev SMTP catcher v Dockeri, nikam neodosiela naozaj) - netreba menit.
# Pre realne dorucenie na STUBA mail vyplň MAIL_HOST/PORT/USERNAME/PASSWORD nizsie a nastav
# MAIL_SMTP_AUTH=true + (port 587: MAIL_SMTP_STARTTLS=true) alebo (port 465: MAIL_SMTP_SSL=true).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Verifikácia <noreply@stuba.sk>
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false

# true: /verify preskočí odoslanie mailu, kód ukáže priamo v Discorde
VERIFICATION_TESTING_MODE=false
