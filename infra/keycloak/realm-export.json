{
  "realm": "ais-auth",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 172800,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "ais-auth-backend",
      "name": "Backend admin service account",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "ais-auth-tokens",
      "name": "Backend-issued user tokens",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-ais-auth-backend",
      "enabled": true,
      "serviceAccountClientId": "ais-auth-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "manage-clients",
          "view-clients",
          "manage-realm"
        ]
      }
    }
  ]
}
